# syntax=docker/dockerfile:1
#
# GPU batch image: Ollama + the evaluation harness, for a job-scheduled node.
#
# Deliberately NOT a tensorflow/ or pytorch/ base image. Inference here runs through
# Ollama, which ships its own CUDA runtime and its own 4-bit quantized weights -- the
# torch in those images would be several GB of unused layer. Ollama is kept (rather
# than swapping to vLLM/HF fp16, which would use an H100 far better) because every
# result reported so far was generated from the same quantized weights: changing the
# inference stack changes the model's output text, and none of the existing 157
# summaries would remain comparable. That is a study-design decision, not a
# performance one -- see docs/GPU_BATCH.md.
#
# torch does still arrive via bert-score, pinned to the CPU wheel: BERTScore is not
# run in the batch path (--no-bertscore), and pulling the CUDA build would add ~2GB
# for an import that never executes.
# BUILD FOR amd64 EXPLICITLY. The dev machines here are Apple Silicon (arm64); every
# H100 host is x86_64. `docker build` defaults to the architecture of the machine doing
# the building, so an image built on a Mac without --platform produces an arm64 image
# that the cluster cannot execute -- and the error surfaces only when the job starts,
# after the queue wait. Build with:
#
#   docker build --platform linux/amd64 -f backend/Dockerfile.gpu -t <tag> backend
#
# (On a Mac this cross-builds under emulation: slower to build, native speed to run.)
FROM --platform=$TARGETPLATFORM ollama/ollama:latest

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    OLLAMA_HOST=http://127.0.0.1:11434 \
    OLLAMA_NUM_CTX=8192 \
    OLLAMA_MAX_LOADED_MODELS=1 \
    OLLAMA_NUM_PARALLEL=1

# OLLAMA_MAX_LOADED_MODELS=1 keeps the generator and the judge from being co-resident.
# On an 80GB H100 that is not a memory necessity as it was on a 4GB laptop, but it
# holds the execution conditions identical to the runs it will be pooled with.

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 --retries 10 \
        --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install --timeout 120 --retries 10 -r requirements.txt

COPY app ./app
COPY scripts ./scripts

# Model weights are NOT baked in: they are ~15GB, they change independently of the
# code, and a compute node that cannot reach the internet cannot pull them at run
# time. Stage them once onto shared storage and mount that directory at
# /root/.ollama -- see docs/GPU_BATCH.md. entrypoint_gpu.sh fails loudly, before
# burning any allocation, if a requested model is not present.
VOLUME ["/root/.ollama"]

COPY scripts/entrypoint_gpu.sh /usr/local/bin/entrypoint_gpu.sh
RUN chmod +x /usr/local/bin/entrypoint_gpu.sh

# Override ollama/ollama's own ENTRYPOINT, which is `ollama` itself.
ENTRYPOINT ["/usr/local/bin/entrypoint_gpu.sh"]
