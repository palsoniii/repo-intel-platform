{
  "overview": "An enterprise-oriented NestJS boilerplate with JWT and OAuth (Google, Apple) authentication, OTP/TOTP two-factor auth, and role-based access control, built on Prisma so it can target any supported database. It follows a modular Repository design pattern aimed at production-ready enterprise and mobile-backend use cases.",
  "tech_stack": [
    "TypeScript",
    "NestJS",
    "Prisma",
    "JWT",
    "OAuth"
  ],
  "services": [
    "HTTP REST API server for authentication and RBAC-gated resources"
  ],
