# Copy to .env and fill in. Never commit .env.

# Neo4j (Phase 2 knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Ollama (Phase 3 -- 3 free local models, no paid APIs)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIMARY=qwen2.5-coder:7b
# Fallback/diversity were originally general-purpose models (llama3.1:8b,
# mistral:7b) -- swapped for code-specialized instruct models after testing.
# Rejected candidates: starcoder2:3b/dolphincoder:7b family (StarCoder2-based --
# ignored the JSON-output instruction and wrote code instead), deepseek-coder:1.3b-
# instruct (matched the JSON shape but returned every field empty -- too small to
# reason over the context, not a training issue: deepseek-coder:6.7b-instruct
# passed the same test), and granite-code:3b-instruct (2026-08-24: swapped for
# codellama:7b-instruct to keep all 3 models size-matched at 6.7-7.6B params --
# granite-code's size gap versus qwen/deepseek was a real, avoidable confound for
# a "3 comparable models" claim, and IBM's own granite-code:8b-instruct would have
# fixed the size gap but codellama is a more literature-recognized baseline).
# Three different training orgs (Alibaba / DeepSeek / Meta), all 6.7-7.6B params,
# so the 3 models are neither "Qwen at 3 sizes" nor confounded by capability tier.
OLLAMA_MODEL_FALLBACK=codellama:7b-instruct
# NOTE: gemma2:9b is also the dashboard's default judge (frontend/src/lib/api.ts).
# run_scored_ablation() refuses to run when the judge is one of the generators, since
# self-judging reverses the ranking of representations (REPORT.md 6.2). Either change
# this writer or pass an explicit judge_model.
OLLAMA_MODEL_DIVERSITY=gemma2:9b
# Context window. Unset -> the model's own default (often only ~2-4K tokens, which
# truncates the raw-code representation). Raise it (e.g. 8192) to give the raw arm a
# fair shot; costs more RAM/time. If you raise this, raise DEFAULT_MAX_RAW_CHARS too.
# MUST be set to 8192 to reproduce any reported result. Left empty, the provider passes
# no num_ctx and Ollama falls back to the model's own default (often 2-4K), which
# silently truncates every arm and makes the run incomparable to the study.
OLLAMA_NUM_CTX=8192

# Evaluation harness safety limits
MAX_REPO_SIZE_MB=200
MAX_FILES_PER_REPO=3000
