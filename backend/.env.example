# Copy to .env and fill in. Never commit .env.

# Neo4j (Phase 2 knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Ollama (Phase 3 -- 3 free local models, no paid APIs)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_PRIMARY=qwen2.5-coder:7b
OLLAMA_MODEL_FALLBACK=llama3.1:8b
OLLAMA_MODEL_DIVERSITY=gpt-oss:20b   # substitute mistral:7b if hardware doesn't support this

# Evaluation harness safety limits
MAX_REPO_SIZE_MB=200
MAX_FILES_PER_REPO=3000
